rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model (excerpt)
    // users.role: paciente | profissional | admin (admin só manual)
    // courses/{id} + modules/{id} + lessons/{id}
    // lessonProgress/{userId}_{lessonId}
    // professionalPatientLinks, dailyCheckins (existing)
    // ===============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSignUpRole(role) {
      return role in ['paciente', 'profissional'];
    }

    function userDoc(userId) {
      return get(/databases/$(database)/documents/users/$(userId));
    }

    function signedInRole() {
      return userDoc(request.auth.uid).data.role;
    }

    function isProfessionalUser() {
      return isSignedIn() && signedInRole() == 'profissional';
    }

    function isPatientUser() {
      return isSignedIn() && signedInRole() == 'paciente';
    }

function isAdminUser() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc(request.auth.uid).data.role == 'admin';
    }

    function authEmail() {
      return request.auth.token.email is string
        ? request.auth.token.email.lower()
        : '';
    }

    function activeLinkDoc(professionalId, patientId) {
      return get(/databases/$(database)/documents/professionalPatientLinks/$(professionalId + '_' + patientId));
    }

    function activeLinkExists(professionalId, patientId) {
      return exists(/databases/$(database)/documents/professionalPatientLinks/$(professionalId + '_' + patientId));
    }

    function hasActiveLinkWithPatient(patientId) {
      return isSignedIn()
        && activeLinkExists(request.auth.uid, patientId)
        && activeLinkDoc(request.auth.uid, patientId).data.status == 'active'
        && activeLinkDoc(request.auth.uid, patientId).data.professionalId == request.auth.uid
        && activeLinkDoc(request.auth.uid, patientId).data.patientId == patientId;
    }

    function pendingLinkPath(professionalId, email) {
      return /databases/$(database)/documents/professionalPatientLinks/$('pending_' + professionalId + '_' + email);
    }

    function hasPendingInviteForAccept(professionalId) {
      return authEmail().size() > 0
        && exists(pendingLinkPath(professionalId, authEmail()))
        && get(pendingLinkPath(professionalId, authEmail())).data.status == 'pending'
        && get(pendingLinkPath(professionalId, authEmail())).data.professionalId == professionalId
        && get(pendingLinkPath(professionalId, authEmail())).data.patientEmail == authEmail();
    }

    function linkRequiredKeys() {
      return [
        'professionalId', 'patientId', 'patientEmail', 'status',
        'createdAt', 'updatedAt', 'acceptedAt', 'revokedAt', 'revokedBy'
      ];
    }

    function isValidPendingCreate(docId) {
      return isProfessionalUser()
        && request.resource.data.professionalId == request.auth.uid
        && request.resource.data.patientId == null
        && request.resource.data.patientEmail is string
        && request.resource.data.patientEmail == request.resource.data.patientEmail.lower()
        && request.resource.data.patientEmail.size() > 3
        && request.resource.data.status == 'pending'
        && request.resource.data.acceptedAt == null
        && request.resource.data.revokedAt == null
        && request.resource.data.revokedBy == null
        && request.resource.data.keys().hasAll(linkRequiredKeys())
        && docId == 'pending_' + request.auth.uid + '_' + request.resource.data.patientEmail;
    }

    function isValidActiveCreateByPatient(docId) {
      return isPatientUser()
        && request.resource.data.patientId == request.auth.uid
        && request.resource.data.professionalId is string
        && request.resource.data.patientEmail == authEmail()
        && request.resource.data.status == 'active'
        && request.resource.data.revokedAt == null
        && request.resource.data.revokedBy == null
        && request.resource.data.keys().hasAll(linkRequiredKeys())
        && docId == request.resource.data.professionalId + '_' + request.auth.uid
        && hasPendingInviteForAccept(request.resource.data.professionalId);
    }

    function linkImmutableCore() {
      return request.resource.data.professionalId == resource.data.professionalId
        && request.resource.data.patientEmail == resource.data.patientEmail;
    }

    function isPatientRejectUpdate() {
      return isPatientUser()
        && resource.data.status == 'pending'
        && resource.data.patientEmail == authEmail()
        && request.resource.data.status == 'rejected'
        && request.resource.data.patientId == request.auth.uid
        && linkImmutableCore()
        && request.resource.data.keys().hasAll(linkRequiredKeys());
    }

    function isProfessionalCancelPending() {
      return isProfessionalUser()
        && resource.data.status == 'pending'
        && resource.data.professionalId == request.auth.uid
        && request.resource.data.status == 'revoked'
        && request.resource.data.revokedBy == 'profissional'
        && linkImmutableCore()
        && request.resource.data.patientId == resource.data.patientId
        && request.resource.data.keys().hasAll(linkRequiredKeys());
    }

    function isRevokeActiveUpdate() {
      return resource.data.status == 'active'
        && request.resource.data.status == 'revoked'
        && request.resource.data.revokedBy in ['profissional', 'paciente']
        && linkImmutableCore()
        && request.resource.data.patientId == resource.data.patientId
        && (
          (isProfessionalUser()
            && resource.data.professionalId == request.auth.uid
            && request.resource.data.revokedBy == 'profissional')
          || (isPatientUser()
            && resource.data.patientId == request.auth.uid
            && request.resource.data.revokedBy == 'paciente')
        )
        && request.resource.data.keys().hasAll(linkRequiredKeys());
    }

    function canReadLink() {
      return isSignedIn() && (
        resource.data.professionalId == request.auth.uid
        || resource.data.patientId == request.auth.uid
        || (resource.data.status == 'pending'
          && resource.data.patientEmail == authEmail())
      );
    }

    function canDeleteLink() {
      return resource.data.status == 'pending' && (
        (isProfessionalUser() && resource.data.professionalId == request.auth.uid)
        || (isPatientUser() && resource.data.patientEmail == authEmail())
      ) || (
        isProfessionalUser()
        && resource.data.professionalId == request.auth.uid
        && resource.data.status in ['rejected', 'revoked']
      );
    }

    function courseDoc(courseId) {
      return get(/databases/$(database)/documents/courses/$(courseId));
    }

    function courseExists(courseId) {
      return exists(/databases/$(database)/documents/courses/$(courseId));
    }

    function canReadCourse(courseId) {
      return isSignedIn()
        && courseExists(courseId)
        && (
          isAdminUser()
          || courseDoc(courseId).data.status == 'published'
          || courseDoc(courseId).data.createdBy == request.auth.uid
        );
    }

    /** Leitura de documento de curso já carregado em `resource` (list/get). */
    function canReadCourseResource() {
      return isSignedIn() && (
        isAdminUser()
        || resource.data.status == 'published'
        || resource.data.createdBy == request.auth.uid
      );
    }

    function canWriteCourseContent(courseId) {
      return isSignedIn()
        && courseExists(courseId)
        && (
          isAdminUser()
          || (
            isProfessionalUser()
            && courseDoc(courseId).data.createdBy == request.auth.uid
            && courseDoc(courseId).data.status in ['draft', 'rejected']
          )
        );
    }

    function courseRequiredKeys() {
      return [
        'title', 'description', 'coverUrl', 'kind', 'status',
        'createdBy', 'createdByRole', 'submittedAt', 'reviewedAt',
        'reviewedBy', 'rejectionReason', 'publishedAt', 'sortOrder',
        'createdAt', 'updatedAt'
      ];
    }

    function isValidCourseCreate() {
      return request.resource.data.keys().hasAll(courseRequiredKeys())
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.description is string
        && request.resource.data.kind in ['curso', 'mentoria']
        && request.resource.data.createdBy == request.auth.uid
        && (
          (
            isAdminUser()
            && request.resource.data.createdByRole == 'admin'
            && request.resource.data.status in [
              'draft', 'pending_review', 'published', 'rejected'
            ]
          )
          || (
            isProfessionalUser()
            && request.resource.data.createdByRole == 'profissional'
            && request.resource.data.status == 'draft'
          )
        );
    }

    function isAdminCourseUpdate() {
      return isAdminUser()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdByRole == resource.data.createdByRole
        && request.resource.data.keys().hasAll(courseRequiredKeys())
        && (
          // Meta/admin edits sem mudar status
          request.resource.data.status == resource.data.status
          // Decisão de revisão: só a partir de pending_review
          || (
            resource.data.status == 'pending_review'
            && request.resource.data.status in ['published', 'rejected']
          )
        );
    }

    function isOwnerCourseMetaOrSubmit() {
      return isProfessionalUser()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdByRole == resource.data.createdByRole
        && request.resource.data.keys().hasAll(courseRequiredKeys())
        && (
          (
            resource.data.status in ['draft', 'rejected']
            && request.resource.data.status in ['draft', 'pending_review']
          )
        )
        && request.resource.data.status != 'published';
    }

    match /users/{userId} {
      allow read: if isOwner(userId)
        || hasActiveLinkWithPatient(userId)
        || isAdminUser();

      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.email is string
        && request.resource.data.name is string
        && isSignUpRole(request.resource.data.role)
        && request.resource.data.keys().hasAll([
          'uid', 'name', 'email', 'role', 'createdAt', 'updatedAt'
        ]);

      allow update: if isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;

      allow delete: if false;
    }

    match /dailyCheckins/{checkinId} {
      // get em doc inexistente: resource é null — sem este caso o app
      // não consegue checar existência antes do create (save/load falham).
      allow get: if isSignedIn() && (
        (
          resource != null
          && (
            resource.data.userId == request.auth.uid
            || hasActiveLinkWithPatient(resource.data.userId)
          )
        )
        || (
          resource == null
          && checkinId.matches('^' + request.auth.uid + '_.*')
        )
      );

      allow list: if isSignedIn()
        && (
          resource.data.userId == request.auth.uid
          || hasActiveLinkWithPatient(resource.data.userId)
        );

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.date is string
        && checkinId == request.auth.uid + '_' + request.resource.data.date
        && request.resource.data.keys().hasAll([
          'userId', 'date', 'treatments', 'activities', 'lifestyle',
          'supplements', 'medications', 'wellbeing', 'measurements',
          'notes', 'createdAt', 'updatedAt'
        ]);

      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.date == resource.data.date;

      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /professionalPatientLinks/{linkId} {
      allow read: if canReadLink();

      allow create: if isValidPendingCreate(linkId) || isValidActiveCreateByPatient(linkId);

      allow update: if isPatientRejectUpdate()
        || isProfessionalCancelPending()
        || isRevokeActiveUpdate();

      allow delete: if canDeleteLink();
    }

    match /courses/{courseId} {
      allow read: if canReadCourseResource();

      allow create: if isValidCourseCreate();

      allow update: if isAdminCourseUpdate() || isOwnerCourseMetaOrSubmit();

      allow delete: if isAdminUser();

      match /modules/{moduleId} {
        allow read: if canReadCourse(courseId);

        allow create, update: if canWriteCourseContent(courseId)
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.description is string
          && request.resource.data.sortOrder is number;

        allow delete: if isAdminUser()
          || (
            isProfessionalUser()
            && courseDoc(courseId).data.createdBy == request.auth.uid
            && courseDoc(courseId).data.status in ['draft', 'rejected']
          );

        match /lessons/{lessonId} {
          allow read: if canReadCourse(courseId);

          allow create, update: if canWriteCourseContent(courseId)
            && request.resource.data.title is string
            && request.resource.data.title.size() > 0
            && request.resource.data.description is string
            && request.resource.data.sortOrder is number
            && request.resource.data.contentType in ['video', 'text'];

          allow delete: if isAdminUser()
            || (
              isProfessionalUser()
              && courseDoc(courseId).data.createdBy == request.auth.uid
              && courseDoc(courseId).data.status in ['draft', 'rejected']
            );
        }
      }
    }

    match /lessonProgress/{progressId} {
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;

      allow create, update: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.courseId is string
        && request.resource.data.moduleId is string
        && request.resource.data.lessonId is string
        && request.resource.data.completed is bool
        && progressId == request.auth.uid + '_' + request.resource.data.lessonId;

      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /contentArticles/{articleId} {
      allow read: if isSignedIn() && (
        isAdminUser()
        || resource.data.status == 'published'
        || resource.data.createdBy == request.auth.uid
      );

      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.summary is string
        && request.resource.data.body is string
        && request.resource.data.kind in ['noticia', 'pesquisa', 'artigo']
        && (
          (isAdminUser()
            && request.resource.data.createdByRole == 'admin'
            && request.resource.data.status in [
              'draft', 'pending_review', 'published', 'rejected'
            ])
          || (isProfessionalUser()
            && request.resource.data.createdByRole == 'profissional'
            && request.resource.data.status == 'draft')
        );

      allow update: if isAdminUser()
        || (
          isProfessionalUser()
          && resource.data.createdBy == request.auth.uid
          && resource.data.status in ['draft', 'rejected']
          && request.resource.data.status in ['draft', 'pending_review']
          && request.resource.data.createdBy == resource.data.createdBy
        );

      allow delete: if isAdminUser();
    }

    match /communities/{communityId} {
      function communityData() {
        return get(/databases/$(database)/documents/communities/$(communityId)).data;
      }

      function isCommunityMember() {
        return isSignedIn()
          && exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid))
          && (
            !get(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)).data.keys().hasAny(['status'])
            || get(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)).data.status == 'active'
          );
      }

      function communityJoinPolicy() {
        return communityData().keys().hasAny(['joinPolicy'])
          ? communityData().joinPolicy
          : 'open';
      }

      function communityPostPolicy() {
        return communityData().keys().hasAny(['postPolicy'])
          ? communityData().postPolicy
          : 'members';
      }

      function communityCommentPolicy() {
        return communityData().keys().hasAny(['commentPolicy'])
          ? communityData().commentPolicy
          : 'members';
      }

      function viewerRole() {
        return exists(/databases/$(database)/documents/users/$(request.auth.uid))
          ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          : '';
      }

      function isCommunityOwner() {
        return isSignedIn() && communityData().createdBy == request.auth.uid;
      }

      function canEngageInCommunity() {
        return isCommunityMember() || isAdminUser() || isCommunityOwner();
      }

      function canPublishByPolicy(policy) {
        return isSignedIn()
          && communityData().status == 'published'
          && (
            isAdminUser()
            || isCommunityOwner()
            || (isCommunityMember() && policy == 'members')
            || (
              isCommunityMember()
              && policy == 'professionals'
              && viewerRole() == 'profissional'
            )
          );
      }

      allow read: if isSignedIn() && (
        isAdminUser()
        || resource.data.status == 'published'
        || resource.data.createdBy == request.auth.uid
      );

      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.description is string
        && request.resource.data.memberCount == 0
        && request.resource.data.postPolicy in [
          'members', 'owner', 'professionals'
        ]
        && request.resource.data.commentPolicy in [
          'members', 'owner', 'professionals'
        ]
        && request.resource.data.joinPolicy in ['open', 'approval']
        && request.resource.data.tags is list
        && (
          (isAdminUser()
            && request.resource.data.createdByRole in ['admin', 'profissional']
            && request.resource.data.status in [
              'draft', 'pending', 'published', 'rejected'
            ])
          || (isProfessionalUser()
            && request.resource.data.createdByRole == 'profissional'
            && request.resource.data.status == 'pending')
        );

      allow update: if isAdminUser()
        || (
          isSignedIn()
          && resource.data.status == 'published'
          && request.resource.data.status == 'published'
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdByRole == resource.data.createdByRole
          && request.resource.data.title == resource.data.title
          && request.resource.data.description == resource.data.description
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['memberCount', 'updatedAt'])
        );

      allow delete: if isAdminUser();

      match /members/{memberId} {
        allow get: if isSignedIn() && (
          (
            resource != null
            && (
              resource.data.userId == request.auth.uid
              || isAdminUser()
              || isCommunityOwner()
              || (
                isCommunityMember()
                && resource.data.status == 'active'
              )
            )
          )
          || (resource == null && memberId == request.auth.uid)
        );

        allow list: if isSignedIn() && (
          resource.data.userId == request.auth.uid
          || isAdminUser()
          || isCommunityOwner()
        );

        allow create: if isSignedIn()
          && memberId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.communityId == communityId
          && request.resource.data.userName is string
          && communityData().status == 'published'
          && request.resource.data.status in ['pending', 'active']
          && (
            (isAdminUser() || isCommunityOwner())
              && request.resource.data.status == 'active'
            || (communityJoinPolicy() == 'open'
              && request.resource.data.status == 'active')
            || (communityJoinPolicy() == 'approval'
              && request.resource.data.status == 'pending')
          );

        allow update: if isSignedIn()
          && (isAdminUser() || isCommunityOwner())
          && resource.data.status == 'pending'
          && request.resource.data.status in ['active', 'rejected']
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.communityId == resource.data.communityId;

        allow delete: if isSignedIn()
          && (
            resource.data.userId == request.auth.uid
            || isAdminUser()
            || isCommunityOwner()
          );
      }

      match /posts/{postId} {
        allow read: if isSignedIn()
          && communityData().status == 'published'
          && canEngageInCommunity();

        allow create: if isSignedIn()
          && canPublishByPolicy(communityPostPolicy())
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.communityId == communityId
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.summary is string
          && request.resource.data.summary.size() > 0
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.authorName is string
          && request.resource.data.likeCount is number
          && request.resource.data.commentCount is number;

        allow update: if isSignedIn() && (
          isAdminUser()
          || resource.data.authorId == request.auth.uid
          || (
            canEngageInCommunity()
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['likeCount', 'commentCount', 'updatedAt'])
          )
        );

        allow delete: if isSignedIn()
          && (isAdminUser() || resource.data.authorId == request.auth.uid);

        match /likes/{likeUserId} {
          allow get: if isSignedIn()
            && communityData().status == 'published'
            && (
              canEngageInCommunity()
              || (resource == null && likeUserId == request.auth.uid)
            );

          allow list: if isSignedIn()
            && communityData().status == 'published'
            && canEngageInCommunity();

          allow create: if isSignedIn()
            && canEngageInCommunity()
            && likeUserId == request.auth.uid
            && request.resource.data.userId == request.auth.uid;

          allow delete: if isSignedIn()
            && resource.data.userId == request.auth.uid;

          allow update: if false;
        }

        match /comments/{commentId} {
          allow read: if isSignedIn()
            && communityData().status == 'published'
            && canEngageInCommunity();

          allow create: if isSignedIn()
            && canPublishByPolicy(communityCommentPolicy())
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.communityId == communityId
            && request.resource.data.postId == postId
            && request.resource.data.body is string
            && request.resource.data.body.size() > 0
            && request.resource.data.authorName is string;

          allow update, delete: if isSignedIn()
            && (isAdminUser() || resource.data.authorId == request.auth.uid);
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
